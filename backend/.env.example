# Core runtime
ENVIRONMENT=development
DEBUG=true
APP_NAME=KanoonEdge API

# Security
SECRET_KEY=your-secret-key-minimum-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Database
# For local development (SQLite fallback), leave DATABASE_URL blank.
# For production (Railway PostgreSQL), set DATABASE_URL from Railway.
DATABASE_URL=postgresql://user:password@host:5432/kanoonedge

# AI
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# CORS / frontend
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# Storage
UPLOAD_DIR=uploads
